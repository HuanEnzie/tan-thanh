{
  "name": "tan-thanh",
  "productName": "Tàn Thành Vạn Giới",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "sync": "node ../sync-www.mjs www",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --win portable nsis"
  },
  "build": {
    "appId": "vn.huanenzie.tanthanh",
    "files": [
      "main.js",
      "www/**/*"
    ],
    "win": {
      "icon": "www/icons/icon-512.png"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^25.0.0"
  },
  "allowScripts": {
    "electron@40.10.2": true
  }
}
